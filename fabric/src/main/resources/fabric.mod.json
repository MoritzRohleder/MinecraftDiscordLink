{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/MoritzRohleder/MinecraftDiscordLink"
    },
    "license": "${license}",
    "environment": "server",
    "entrypoints": {
        "server": [
            "de.moritzrohleder.minecraftdiscordlink.MinecraftDiscordLinkFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
